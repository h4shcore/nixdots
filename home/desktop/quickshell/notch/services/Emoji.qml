pragma Singleton
import QtQuick
import Quickshell

// Emoji picker data + search for the launcher (":" mode).
// Each entry: "char|official name|extra keywords". Most-used emoji come first.
Singleton {
    id: root

    readonly property var index: data.map((l, i) => {
        const p = l.split("|");
        return { id: "emoji:" + i, kind: "emoji", char: p[0], name: p[1], keys: p[2] ?? "", text: p[0], order: i };
    })

    function score(e, q) {
        if (e.name === q) return 100;
        const words = (e.name + " " + e.keys).split(/[\s\-]+/);
        if (words.some(w => w === q)) return 90;
        if (e.name.startsWith(q)) return 85;
        if (words.some(w => w.startsWith(q))) return 75;
        if (e.name.includes(q)) return 55;
        if (e.keys.includes(q)) return 50;
        return 0;
    }

    function search(query) {
        const q = (query ?? "").trim().toLowerCase();
        if (q === "") return index.slice(0, 60);
        const out = [];
        for (const e of index) {
            const s = score(e, q);
            if (s > 0) out.push({ e: e, s: s });
        }
        out.sort((a, b) => b.s - a.s || a.e.order - b.e.order);
        return out.slice(0, 60).map(x => x.e);
    }

